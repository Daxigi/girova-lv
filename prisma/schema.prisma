generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model action_files {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  request_action_id BigInt          @db.UnsignedBigInt
  procedure_id      Int
  request_id        Int
  user              Int
  action_id         Int
  date              DateTime        @db.DateTime(0)
  deleted_at        DateTime?       @db.Timestamp(0)
  created_at        DateTime?       @db.Timestamp(0)
  updated_at        DateTime?       @db.Timestamp(0)
  request_actions   request_actions @relation(fields: [request_action_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "action_files_request_action_id_foreign")

  @@index([request_action_id], map: "action_files_request_action_id_foreign")
}

model actions {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  procedure_id    Int
  description     String
  deleted_at      DateTime?         @db.Timestamp(0)
  created_at      DateTime?         @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  status          String            @default("1") @db.VarChar(1)
  request_actions request_actions[]
}

model area_user {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  area_id    BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  areas      areas     @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "area_user_area_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "area_user_user_id_foreign")

  @@index([area_id], map: "area_user_area_id_foreign")
  @@index([user_id], map: "area_user_user_id_foreign")
}

model areas {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  descripcion String
  deleted_at  DateTime?    @db.Timestamp(0)
  created_at  DateTime?    @db.Timestamp(0)
  updated_at  DateTime?    @db.Timestamp(0)
  area_user   area_user[]
  procedures  procedures[]
}

model attached_files {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  ruta         String
  form_id      BigInt    @db.UnsignedBigInt
  user_id      BigInt    @db.UnsignedBigInt
  instancia_id BigInt    @db.UnsignedBigInt
  size         String
  amount       String?   @db.VarChar(10)
  hash         String
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
}

model component_forms {
  id                                                          BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  required                                                    String
  size                                                        Int                               @default(255)
  max_num                                                     Int?
  min_mun                                                     Int?
  label                                                       String                            @db.VarChar(300)
  help                                                        String?
  is_multiple_choice                                          Boolean                           @default(false)
  placeholder                                                 String?
  tag_name                                                    String
  tag_id                                                      String?
  value_choices                                               String?                           @db.LongText
  type_description                                            component_forms_type_description?
  mask_description                                            String?
  form_id                                                     BigInt                            @db.UnsignedBigInt
  component_id                                                BigInt                            @db.UnsignedBigInt
  status                                                      Int                               @default(1)
  created_at                                                  DateTime?                         @db.Timestamp(0)
  updated_at                                                  DateTime?                         @db.Timestamp(0)
  orden                                                       String?
  components                                                  components                        @relation(fields: [component_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "component_forms_component_id_foreign")
  forms                                                       forms                             @relation(fields: [form_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "component_forms_form_id_foreign")
  response_forms_response_forms_component_idTocomponent_forms response_forms[]                  @relation("response_forms_component_idTocomponent_forms")
  response_forms_response_forms_form_idTocomponent_forms      response_forms[]                  @relation("response_forms_form_idTocomponent_forms")

  @@index([component_id], map: "component_forms_component_id_foreign")
  @@index([form_id], map: "component_forms_form_id_foreign")
}

model components {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  code            String            @unique(map: "components_code_unique")
  status          Boolean
  created_at      DateTime?         @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  component_forms component_forms[]
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique")
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model forms {
  id                      BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                 BigInt            @db.UnsignedBigInt
  tittle                  String            @unique(map: "forms_tittle_unique")
  description             String            @db.Text
  status                  Boolean
  assing_user_id          String?
  deleted_at              String            @default("")
  attached_files_required Boolean
  attached_files_signed   Boolean
  created_at              DateTime?         @db.Timestamp(0)
  updated_at              DateTime?         @db.Timestamp(0)
  component_forms         component_forms[]
  users                   users             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "forms_user_id_foreign")

  @@index([user_id], map: "forms_user_id_foreign")
}

model message_files {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  message_id    BigInt    @db.UnsignedBigInt
  user_id       Int
  file          String
  original_name String
  size          Float
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  messages      messages  @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "message_files_message_id_foreign")

  @@index([message_id], map: "message_files_message_id_foreign")
}

model messages {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  tittle          String?
  content         String          @db.LongText
  emisor_id       Int
  receptor_id     Int
  readd           DateTime?       @db.DateTime(0)
  send            DateTime        @db.DateTime(0)
  conversation_id DateTime?       @db.DateTime(0)
  created_at      DateTime?       @db.Timestamp(0)
  updated_at      DateTime?       @db.Timestamp(0)
  request_id      BigInt          @db.UnsignedBigInt
  action_id       BigInt?         @db.UnsignedBigInt
  status_id       BigInt?         @db.UnsignedBigInt
  current_role    String          @default("vecino nivel 2")
  message_files   message_files[]
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String
  batch     Int
}

model model_has_permissions {
  permission_id BigInt      @db.UnsignedBigInt
  model_type    String
  model_id      BigInt      @db.UnsignedBigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "model_has_permissions_permission_id_foreign")

  @@id([permission_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_permissions_model_id_model_type_index")
}

model model_has_roles {
  role_id    BigInt @db.UnsignedBigInt
  model_type String
  model_id   BigInt @db.UnsignedBigInt
  roles      roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "model_has_roles_role_id_foreign")

  @@id([role_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_roles_model_id_model_type_index")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model password_reset_tokens {
  email      String
  token      String
  created_at DateTime? @db.Timestamp(0)

  @@index([email], map: "password_resets_email_index")
  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model password_resets {
  email      String
  token      String
  created_at DateTime? @db.Timestamp(0)

  @@index([email], map: "password_resets_email_index")
  @@ignore
}

model permissions {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  name                  String
  guard_name            String
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  model_has_permissions model_has_permissions[]
  role_has_permissions  role_has_permissions[]

  @@unique([name, guard_name], map: "permissions_name_guard_name_unique")
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model procedure_users {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  id_procedure BigInt     @db.UnsignedBigInt
  id_user      BigInt     @db.UnsignedBigInt
  created_at   DateTime?  @db.Timestamp(0)
  updated_at   DateTime?  @db.Timestamp(0)
  procedures   procedures @relation(fields: [id_procedure], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "procedure_users_id_procedure_foreign")
  users        users      @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "procedure_users_id_user_foreign")

  @@index([id_procedure], map: "procedure_users_id_procedure_foreign")
  @@index([id_user], map: "procedure_users_id_user_foreign")
}

model procedures {
  id                  BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  user_id             Int
  topic_id            BigInt               @db.UnsignedBigInt
  area_id             BigInt               @db.UnsignedBigInt
  procedure_status_id BigInt               @db.UnsignedBigInt
  form_id             Int
  name                String
  description         String
  code                String
  image               String
  link                String
  require_payment     Boolean?
  paying_code         String
  multiple_request    Boolean              @default(false)
  type                procedures_type      @default(externa)
  deleted_at          DateTime?            @db.Timestamp(0)
  created_at          DateTime?            @db.Timestamp(0)
  updated_at          DateTime?            @db.Timestamp(0)
  level               String?
  cupo                Int                  @default(20)
  view_user           procedures_view_user @default(si)
  caducidad           Int?
  send                Boolean              @default(false)
  procedure_users     procedure_users[]
  areas               areas                @relation(fields: [area_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "procedures_area_id_foreign")
  procedures_statuses procedures_statuses  @relation(fields: [procedure_status_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "procedures_procedure_status_id_foreign")
  topics              topics               @relation(fields: [topic_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "procedures_topic_id_foreign")
  requests            requests[]

  @@index([area_id], map: "procedures_area_id_foreign")
  @@index([procedure_status_id], map: "procedures_procedure_status_id_foreign")
  @@index([topic_id], map: "procedures_topic_id_foreign")
}

model procedures_statuses {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  descripcion String
  deleted_at  DateTime?    @db.Timestamp(0)
  created_at  DateTime?    @db.Timestamp(0)
  updated_at  DateTime?    @db.Timestamp(0)
  procedures  procedures[]
}

model request_actions {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  action_id    BigInt         @db.UnsignedBigInt
  request_id   BigInt         @db.UnsignedBigInt
  procedure_id Int
  user_id      Int
  date         DateTime       @db.DateTime(0)
  deleted_at   DateTime?      @db.Timestamp(0)
  created_at   DateTime?      @db.Timestamp(0)
  updated_at   DateTime?      @db.Timestamp(0)
  action_files action_files[]
  actions      actions        @relation(fields: [action_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "request_actions_action_id_foreign")
  requests     requests       @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "request_actions_request_id_foreign")

  @@index([action_id], map: "request_actions_action_id_foreign")
  @@index([request_id], map: "request_actions_request_id_foreign")
}

model request_state_records {
  id                BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  request_id        BigInt         @db.UnsignedBigInt
  procedure_id      Int
  user_id           Int
  date              DateTime       @db.DateTime(0)
  request_status_id BigInt         @db.UnsignedBigInt
  deleted_at        DateTime?      @db.Timestamp(0)
  created_at        DateTime?      @db.Timestamp(0)
  updated_at        DateTime?      @db.Timestamp(0)
  requests          requests       @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "request_state_records_request_id_foreign")
  request_states    request_states @relation(fields: [request_status_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "request_state_records_request_status_id_foreign")

  @@index([request_id], map: "request_state_records_request_id_foreign")
  @@index([request_status_id], map: "request_state_records_request_status_id_foreign")
}

model request_states {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  description           String
  deleted_at            DateTime?               @db.Timestamp(0)
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  request_state_records request_state_records[]
}

model request_types {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  description String
  deleted_at  DateTime?  @db.Timestamp(0)
  created_at  DateTime?  @db.Timestamp(0)
  updated_at  DateTime?  @db.Timestamp(0)
  requests    requests[]
}

model requests {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  procedure_id          BigInt                  @db.UnsignedBigInt
  request_type_id       BigInt                  @db.UnsignedBigInt
  user_id               Int
  start_date            DateTime                @db.Timestamp(0)
  finish_date           DateTime?               @db.Timestamp(0)
  due_date              DateTime?               @db.Timestamp(0)
  response_time         Int?
  reference_number      Int
  deleted_at            DateTime?               @db.Timestamp(0)
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  code                  String?
  attended_by           BigInt?                 @db.UnsignedBigInt
  request_actions       request_actions[]
  request_state_records request_state_records[]
  users                 users?                  @relation(fields: [attended_by], references: [id], onUpdate: NoAction, map: "requests_attended_by_foreign")
  procedures            procedures              @relation(fields: [procedure_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "requests_procedure_id_foreign")
  request_types         request_types           @relation(fields: [request_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "requests_request_type_id_foreign")
  response_requests     response_requests[]

  @@index([attended_by], map: "requests_attended_by_foreign")
  @@index([procedure_id], map: "requests_procedure_id_foreign")
  @@index([request_type_id], map: "requests_request_type_id_foreign")
}

model response_forms {
  id                                                           BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  key                                                          String
  value                                                        String
  status                                                       response_forms_status @default(dbgenerated("1"))
  messageDelete                                                String?
  instancia_id                                                 Int
  component_id                                                 BigInt                @db.UnsignedBigInt
  user_id                                                      BigInt                @db.UnsignedBigInt
  form_id                                                      BigInt                @db.UnsignedBigInt
  created_at                                                   DateTime?             @db.Timestamp(0)
  updated_at                                                   DateTime?             @db.Timestamp(0)
  component_forms_response_forms_component_idTocomponent_forms component_forms       @relation("response_forms_component_idTocomponent_forms", fields: [component_id], references: [component_id], onDelete: NoAction, onUpdate: NoAction, map: "response_forms_component_id_foreign")
  component_forms_response_forms_form_idTocomponent_forms      component_forms       @relation("response_forms_form_idTocomponent_forms", fields: [form_id], references: [form_id], onDelete: NoAction, onUpdate: NoAction, map: "response_forms_form_id_foreign")
  users                                                        users                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "response_forms_user_id_foreign")

  @@index([component_id], map: "response_forms_component_id_foreign")
  @@index([form_id], map: "response_forms_form_id_foreign")
  @@index([user_id], map: "response_forms_user_id_foreign")
}

model response_requests {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  request_id BigInt    @db.UnsignedBigInt
  instancia  Int
  deleted_at DateTime? @db.Timestamp(0)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  requests   requests  @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "response_requests_request_id_foreign")

  @@index([request_id], map: "response_requests_request_id_foreign")
}

model rol__histories {
  id                                    BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  tipo_validacion                       BigInt?         @db.UnsignedBigInt
  user_id                               BigInt          @db.UnsignedBigInt
  agente_id                             BigInt?         @db.UnsignedBigInt
  created_at                            DateTime?       @db.Timestamp(0)
  updated_at                            DateTime?       @db.Timestamp(0)
  motivo                                String?
  aprobado                              Boolean?
  users_rol__histories_agente_idTousers users?          @relation("rol__histories_agente_idTousers", fields: [agente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "rol__histories_agente_id_foreign")
  roles__details                        roles__details? @relation(fields: [tipo_validacion], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "rol__histories_tipo_validacion_foreign")
  users_rol__histories_user_idTousers   users           @relation("rol__histories_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "rol__histories_user_id_foreign")

  @@index([agente_id], map: "rol__histories_agente_id_foreign")
  @@index([tipo_validacion], map: "rol__histories_tipo_validacion_foreign")
  @@index([user_id], map: "rol__histories_user_id_foreign")
}

model role_has_permissions {
  permission_id BigInt      @db.UnsignedBigInt
  role_id       BigInt      @db.UnsignedBigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_has_permissions_permission_id_foreign")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_has_permissions_role_id_foreign")

  @@id([permission_id, role_id])
  @@index([role_id], map: "role_has_permissions_role_id_foreign")
}

model roles {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String
  guard_name           String
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  model_has_roles      model_has_roles[]
  role_has_permissions role_has_permissions[]

  @@unique([name, guard_name], map: "roles_name_guard_name_unique")
}

model roles__details {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  detalle        String
  nivel_rol      String
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
  rol__histories rol__histories[]
}

model topics {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  description String
  deleted_at  DateTime?    @db.Timestamp(0)
  created_at  DateTime?    @db.Timestamp(0)
  updated_at  DateTime?    @db.Timestamp(0)
  procedures  procedures[]
}

model users {
  id                                             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  name                                           String
  surname                                        String
  dni                                            String            @unique(map: "users_dni_unique")
  cuil                                           String            @unique(map: "users_cuil_unique")
  email                                          String            @unique(map: "users_email_unique")
  deleted_at                                     DateTime?         @db.Timestamp(0)
  email_verified_at                              DateTime?         @db.Timestamp(0)
  password                                       String
  change_pass                                    String            @default("")
  session                                        String?
  remember_token                                 String?           @db.VarChar(100)
  created_at                                     DateTime?         @db.Timestamp(0)
  updated_at                                     DateTime?         @db.Timestamp(0)
  is_email_verified                              Boolean           @default(false)
  sexo_id                                        Int?
  domicilio                                      String?
  dni_frente                                     String?           @map("dni-frente")
  dni_dorso                                      String?           @map("dni-dorso")
  fecha_nacimiento                               DateTime?         @db.Date
  celular                                        String?
  current_role                                   String?
  token_sac                                      String?
  ultima_conexion                                DateTime?         @db.Timestamp(0)
  related_person                                 String?
  area_user                                      area_user[]
  forms                                          forms[]
  procedure_users                                procedure_users[]
  requests                                       requests[]
  response_forms                                 response_forms[]
  rol__histories_rol__histories_agente_idTousers rol__histories[]  @relation("rol__histories_agente_idTousers")
  rol__histories_rol__histories_user_idTousers   rol__histories[]  @relation("rol__histories_user_idTousers")
}

model users_verify {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    Int
  token      String
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

enum response_forms_status {
  // 0 @map("0")
  // 1 @map("1")
}

enum component_forms_type_description {
  text
  number
  date
  file
  time
  email
  checkbox
  select
  textarea
  radio
  map
}

enum procedures_type {
  interno
  externa
  ambos
}

enum procedures_view_user {
  si
  no
}
